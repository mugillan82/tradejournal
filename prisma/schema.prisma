// Trading Journal Database Schema
// Production-grade schema for trading journal domain

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================
// BETTER AUTH MODELS
// ====================
// Required by Better Auth for email/password and OAuth authentication.
// These models are managed by Better Auth — do not modify fields directly.

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailVerified Boolean @default(false)
  image         String?

  sessions Session[]
  accounts Account[]

  // Trading Journal relations (auth user owns all trading data)
  tradingAccounts TradingAccount[]
  trades          Trade[]
  journalEntries  JournalEntry[]
  reviews         Review[]
  notebookNotes   NotebookNote[]
  reviewTemplates ReviewTemplate[]

  @@index([email])
  @@map("user")
}

model Account {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Better Auth OAuth fields
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  // Required by Better Auth but never written by it
  name String?
  type String?

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ====================
// ENUMS
// ====================

enum TradeSide {
  LONG
  SHORT
}

enum TradeStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum ExecutionSide {
  ENTRY
  EXIT
}

enum JournalMood {
  VERY_BAD
  BAD
  NEUTRAL
  GOOD
  VERY_GOOD
}

enum ReviewStatus {
  DRAFT
  IN_REVIEW
  COMPLETED
}

// ====================
// TRADE JOURNAL DOMAIN MODELS
// ====================

model TradingAccount {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String // e.g., "Interactive Brokers - Main"
  type           String   @default("PAPER_TRADING") // SIMULATION, PAPER_TRADING, LIVE, DEMO
  currency       String   @default("USD")
  initialBalance Decimal? @db.Decimal(18, 2)
  currentBalance Decimal? @db.Decimal(18, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  trades Trade[]

  @@index([userId])
  @@index([isActive, userId])
  @@index([currency])
  @@map("trading_account")
}

model Trade {
  id               String         @id @default(uuid())
  tradingAccountId String
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Trade direction
  side TradeSide

  // Entry
  entryPrice Decimal  @db.Decimal(18, 8)
  entryDate  DateTime

  // Exit (nullable for open trades)
  exitPrice Decimal?  @db.Decimal(18, 8)
  exitDate  DateTime?

  // Risk management
  stopLoss          Decimal? @db.Decimal(18, 8)
  takeProfit        Decimal? @db.Decimal(18, 8)
  riskAmount        Decimal? @db.Decimal(18, 2) // dollar amount risked
  plannedRiskReward Decimal? @db.Decimal(10, 2) // planned risk:reward ratio
  actualRMultiple   Decimal? @db.Decimal(10, 2) // realized R-multiple (calculated from P&L / riskAmount)

  // Position sizing
  quantity Decimal @db.Decimal(18, 8) // position size

  // P&L (before costs)
  grossPnl Decimal? @db.Decimal(18, 2)

  // Costs
  commission Decimal? @db.Decimal(18, 2) // broker commission
  fees       Decimal? @db.Decimal(18, 2) // exchange/regulatory fees
  swap       Decimal? @db.Decimal(18, 2) // overnight financing/rollover

  // Net P&L (after costs)
  netPnl Decimal? @db.Decimal(18, 2)

  // Status
  status TradeStatus @default(OPEN)

  // Optional references
  title      String?
  notes      String?
  strategyId String?
  strategy   Strategy? @relation(fields: [strategyId], references: [id])
  setupId    String?
  setup      Setup?    @relation(fields: [setupId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  executions  Execution[]    @relation("TradeExecutions")
  tags        TradeTag[]     @relation("TradeTags")
  mistakes    TradeMistake[] @relation("TradeMistakes")
  tradeNotes  TradeNote[]    @relation("TradeNotes")
  attachments Attachment[]   @relation("TradeAttachments")
  reviewedIn  ReviewTrade[]  @relation("ReviewTrades")
  journalEntries JournalEntryTrade[]

  // Indexes for query performance
  @@index([userId, status])
  @@index([tradingAccountId, entryDate])
  @@index([entryDate])
  @@index([side, status])
  @@index([strategyId])
  @@index([setupId])
  @@index([userId, entryDate])
  @@index([userId, exitDate])
  @@index([userId, side, status])
  @@index([netPnl])
}

model Execution {
  id      String @id @default(uuid())
  tradeId String
  trade   Trade  @relation("TradeExecutions", fields: [tradeId], references: [id], onDelete: Cascade)

  side     ExecutionSide // ENTRY or EXIT
  price    Decimal       @db.Decimal(18, 8)
  quantity Decimal       @db.Decimal(18, 8)
  datetime DateTime

  commission Decimal? @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@index([tradeId, datetime])
  @@index([datetime])
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())

  trades       TradeTag[]        @relation("TradeTags")
  journalTags  JournalEntryTag[]
  notebookTags NotebookNoteTag[]
  reviewTags   ReviewTag[]

  @@index([name])
}

model TradeTag {
  id      String @id @default(uuid())
  tradeId String
  trade   Trade  @relation("TradeTags", fields: [tradeId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation("TradeTags", fields: [tagId], references: [id], onDelete: Restrict)

  @@unique([tradeId, tagId])
  @@index([tagId])
}

model Strategy {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trades        Trade[]
  reviews       Review[]
  notebookNotes NotebookNote[]

  @@index([name])
}

model Setup {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  trades        Trade[]
  reviews       Review[]
  notebookNotes NotebookNote[]

  @@index([name])
}

model Mistake {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  trades         TradeMistake[]  @relation("TradeMistakes")
  reviewMistakes ReviewMistake[]

  @@index([name])
}

model TradeMistake {
  id        String  @id @default(uuid())
  tradeId   String
  trade     Trade   @relation("TradeMistakes", fields: [tradeId], references: [id], onDelete: Cascade)
  mistakeId String
  mistake   Mistake @relation("TradeMistakes", fields: [mistakeId], references: [id], onDelete: Restrict)

  @@unique([tradeId, mistakeId])
  @@index([mistakeId])
}

model Attachment {
  id             String        @id @default(uuid())
  tradeId        String?
  trade          Trade?        @relation("TradeAttachments", fields: [tradeId], references: [id], onDelete: Cascade)
  journalEntryId String?
  journalEntry   JournalEntry? @relation("JournalAttachments", fields: [journalEntryId], references: [id], onDelete: Cascade)
  reviewId       String?
  review         Review?       @relation("ReviewAttachments", fields: [reviewId], references: [id], onDelete: Cascade)
  notebookNoteId String?
  notebookNote   NotebookNote? @relation("NotebookAttachments", fields: [notebookNoteId], references: [id], onDelete: Cascade)

  fileName   String
  fileUrl    String
  fileSize   Int?
  mimeType   String?
  uploadedAt DateTime @default(now())

  @@index([tradeId])
  @@index([journalEntryId])
  @@index([reviewId])
  @@index([notebookNoteId])
}

model TradeNote {
  id        String   @id @default(uuid())
  tradeId   String
  trade     Trade    @relation("TradeNotes", fields: [tradeId], references: [id], onDelete: Cascade)
  content   String
  phase     String?  // PRE_TRADE, ENTRY, MANAGEMENT, EXIT, POST_TRADE, GENERAL
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([tradeId])
  @@index([tradeId, phase])
}

model JournalEntry {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  entryDate DateTime
  title     String?
  mood      JournalMood?
  energy    Int?
  focus     Int?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments Attachment[]        @relation("JournalAttachments")
  tags        JournalEntryTag[]
  trades      JournalEntryTrade[]

  @@unique([userId, entryDate])
  @@index([userId])
  @@index([entryDate])
}

model JournalEntryTag {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  tagId          String
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@unique([journalEntryId, tagId])
  @@index([tagId])
}

model JournalEntryTrade {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  tradeId        String
  trade          Trade        @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([journalEntryId, tradeId])
  @@index([tradeId])
}

model NotebookNote {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  content    String
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  strategyId String?
  strategy   Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  setupId    String?
  setup      Setup?    @relation(fields: [setupId], references: [id], onDelete: SetNull)

  tags        NotebookNoteTag[]
  attachments Attachment[]      @relation("NotebookAttachments")

  @@index([userId])
  @@index([userId, isArchived])
  @@index([createdAt])
}

model NotebookNoteTag {
  id     String       @id @default(uuid())
  noteId String
  note   NotebookNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag          @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@unique([noteId, tagId])
  @@index([tagId])
}

model ReviewTemplate {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        String   // PRE_TRADE, POST_TRADE, WEEKLY, CUSTOM
  prompts     String   // JSON string of structured prompt sections
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews Review[]

  @@index([userId])
  @@index([isDefault])
}

model Review {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title      String?
  reviewDate DateTime
  notes      String?
  rating     Int?
  status     ReviewStatus @default(DRAFT)

  // Structured retrospective analysis
  thesis               String?
  whatWentWell         String?
  whatWentWrong        String?
  executionQuality     Int?
  ruleAdherence        Int?
  riskManagement       Int?
  emotionalObservation String?
  lessonsLearned       String?
  improvementActions   String?

  templateId String?
  template   ReviewTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  strategyId String?
  strategy   Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  setupId    String?
  setup      Setup?    @relation(fields: [setupId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trades      ReviewTrade[]   @relation("ReviewTrades")
  tags        ReviewTag[]
  mistakes    ReviewMistake[]
  attachments Attachment[]    @relation("ReviewAttachments")

  @@index([userId])
  @@index([reviewDate])
  @@index([userId, reviewDate])
  @@index([userId, status])
}

model ReviewTrade {
  id       String @id @default(uuid())
  reviewId String
  review   Review @relation("ReviewTrades", fields: [reviewId], references: [id], onDelete: Cascade)
  tradeId  String
  trade    Trade  @relation("ReviewTrades", fields: [tradeId], references: [id], onDelete: Cascade)

  notes  String?
  rating Int?

  @@unique([reviewId, tradeId])
  @@index([tradeId])
}

model ReviewTag {
  id       String @id @default(uuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  tagId    String
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@unique([reviewId, tagId])
  @@index([tagId])
}

model ReviewMistake {
  id        String  @id @default(uuid())
  reviewId  String
  review    Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  mistakeId String
  mistake   Mistake @relation(fields: [mistakeId], references: [id], onDelete: Restrict)

  @@unique([reviewId, mistakeId])
  @@index([mistakeId])
}
